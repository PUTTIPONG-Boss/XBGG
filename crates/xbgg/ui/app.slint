// XBGG — terminal-style shell UI.
//
// Design rules: one monospace face, one accent colour, 1px frames with the
// title on the border, inverse video for the selection, no animation, no
// gradients, no rounded corners.

import "../assets/fonts/CascadiaMono-Regular.ttf";
import "../assets/fonts/CascadiaMono-Bold.ttf";

export struct GameTile {
    id: string,
    title: string,
    // "steam", "epic", "gog", "custom"
    source: string,
    // "2h ago", "3d ago", "-"
    played: string,
    // store-specific detail, e.g. "app 1422450"
    detail: string,
    // install folder or file
    path: string,
}

// One row of the menu. `value` "On"/"Off" renders as a checkbox.
export struct MenuRow {
    id: string,
    label: string,
    value: string,
    on: bool,
    dim: bool,
}

// One row of "apps to freeze".
export struct AppRow {
    name: string,
    detail: string,
    on: bool,
}

global T {
    out property <color> bg: #0c0c0c;
    out property <color> fg: #c8c8c8;
    out property <color> bright: #f2f2f2;
    out property <color> dim: #6e6e6e;
    out property <color> line: #3c3c3c;
    out property <color> accent: #5fd787;
    out property <color> amber: #e5c07b;
    out property <color> red: #e06c75;
    // Base font size; set from the window height.
    in-out property <length> fs: 18px;
    out property <length> ch: self.fs * 0.6;
    out property <length> row-h: self.fs * 1.6;
}

// A 1px frame with its title sitting on the top border.
component Frame inherits Rectangle {
    in property <string> title;
    in property <color> tone: T.line;
    in property <color> title-color: T.dim;
    border-width: 1px;
    border-color: root.tone;

    if root.title != "": Rectangle {
        x: T.ch * 2;
        y: -self.height / 2;
        width: label.preferred-width + T.ch * 2;
        height: T.fs * 1.3;
        background: T.bg;
        label := Text {
            text: root.title;
            color: root.title-color;
            font-size: T.fs;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    @children
}

// "[A] play" — key in a block, label after it.
component Key inherits HorizontalLayout {
    in property <string> k;
    in property <string> label;
    in property <bool> hot;
    spacing: T.ch;
    Rectangle {
        width: kt.preferred-width + T.ch * 1.2;
        background: root.hot ? T.accent : T.line;
        kt := Text {
            text: root.k;
            color: root.hot ? T.bg : T.bright;
            font-size: T.fs * 0.9;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        text: root.label;
        color: T.fg;
        font-size: T.fs * 0.9;
        vertical-alignment: center;
    }
}

// "source   steam" — dim key in a fixed column, value after it.
component Kv inherits HorizontalLayout {
    in property <string> k;
    in property <string> v;
    Text {
        width: T.ch * 9;
        text: root.k;
        color: T.dim;
        font-size: T.fs;
    }
    Text {
        horizontal-stretch: 1;
        text: root.v;
        color: T.fg;
        font-size: T.fs;
        overflow: elide;
    }
}

// Dimmed screen with a framed box in the middle.
component Modal inherits Rectangle {
    in property <string> title;
    in property <length> box-width;
    in property <length> box-height;
    callback dismissed();
    background: #0c0c0cd8;

    TouchArea {
        clicked => {
            root.dismissed();
        }
    }

    Rectangle {
        x: (root.width - root.box-width) / 2;
        y: (root.height - root.box-height) / 2;
        width: root.box-width;
        height: root.box-height;
        background: T.bg;
        TouchArea { }
        Frame {
            title: root.title;
            tone: T.accent;
            title-color: T.accent;
            @children
        }
    }
}

export component AppWindow inherits Window {
    title: "XBGG";
    icon: @image-url("../assets/icon.png");
    background: T.bg;
    preferred-width: 1600px;
    preferred-height: 900px;
    min-width: 960px;
    min-height: 600px;
    default-font-family: "Cascadia Mono";
    forward-focus: keys;

    in property <[GameTile]> games;
    in-out property <int> selected: 0;
    in property <string> clock;
    in property <string> status;
    in property <int> scanned-count;
    // Cover of the focused entry, loaded by Rust at `cover-w` x `cover-h`.
    in property <image> cover;
    in property <bool> has-cover;
    in property <string> version;
    // Newer version available on GitHub ("" = none).
    in property <string> update-version;
    // True while a modal native dialog (file picker) or an update runs.
    in property <bool> input-blocked;
    // 0 = none, 1 = confirm exit, 2 = confirm remove, 3 = confirm update
    in-out property <int> dialog: 0;

    // Panels: 0 = none, 1 = menu, 2 = apps to freeze.
    in-out property <int> panel: 0;
    in property <[MenuRow]> menu-rows;
    in-out property <int> menu-index: 0;
    in property <[AppRow]> app-rows;
    in-out property <int> app-index: 0;
    // While a boost runs: what it did ("" = no boost running).
    in property <string> boost-chip;
    in property <bool> boost-enabled;

    callback launch(int);
    callback add-program();
    callback remove-entry(int);
    callback rescan();
    callback quit();
    callback focused(int);
    callback install-update();
    callback menu-open();
    callback menu-select(string);
    callback apps-open();
    callback app-toggle(int);
    // Window size changed: the cover must be re-prepared at the new size.
    callback layout-changed();

    // ---------------------------------------------------------------- layout

    property <length> fs: max(14px, min(28px, root.height / 54));
    init => {
        T.fs = root.fs;
    }
    changed fs => {
        T.fs = root.fs;
        root.layout-changed();
    }

    property <length> pad: T.fs * 1.2;
    property <length> top-h: T.fs * 2;
    property <length> foot-h: T.fs * 3.4;
    property <length> body-y: root.pad + root.top-h + T.fs * 0.8;
    property <length> body-h: root.height - root.body-y - root.foot-h - root.pad * 0.5;
    property <length> list-w: (root.width - 3 * root.pad) * 0.56;
    property <length> info-x: root.pad * 2 + root.list-w;
    property <length> info-w: root.width - root.info-x - root.pad;

    property <int> count: root.games.length + 1;
    property <bool> on-add: root.selected >= root.games.length;
    property <GameTile> current: root.games[root.selected];
    property <int> rows-fit: max(1, floor((root.body-h - T.fs * 2) / T.row-h));
    // First visible row; keeps the selection in view.
    property <int> scroll: max(0, min(root.selected - floor(root.rows-fit / 2), root.count - root.rows-fit));

    // Cover box: 2:3, as large as the info pane allows. Exposed so Rust can
    // decode the image at exactly this size.
    out property <length> cover-w: min(root.info-w - T.ch * 6, (root.body-h * 0.58) * 2 / 3);
    out property <length> cover-h: root.cover-w * 1.5;
    changed cover-w => {
        root.layout-changed();
    }

    changed selected => {
        root.focused(root.selected);
    }

    // ------------------------------------------------------------ navigation

    // Nothing modal is open: the library has the input.
    property <bool> idle: root.dialog == 0 && !root.input-blocked && root.panel == 0;

    public function nav(delta: int) {
        if (root.idle) {
            root.selected = max(0, min(root.selected + delta, root.count - 1));
        }
    }

    public function nav-vertical(delta: int) {
        if (root.dialog != 0 || root.input-blocked) {
            return;
        }
        if (root.panel == 1) {
            root.menu-index = max(0, min(root.menu-index + delta, root.menu-rows.length - 1));
        } else if (root.panel == 2) {
            root.app-index = max(0, min(root.app-index + delta, root.app-rows.length - 1));
        } else {
            root.nav(delta);
        }
    }

    public function activate() {
        if (root.input-blocked) {
            return;
        }
        if (root.dialog == 1) {
            root.dialog = 0;
            root.quit();
        } else if (root.dialog == 2) {
            root.dialog = 0;
            root.remove-entry(root.selected);
        } else if (root.dialog == 3) {
            root.dialog = 0;
            root.install-update();
        } else if (root.panel == 1) {
            root.menu-select(root.menu-rows[root.menu-index].id);
        } else if (root.panel == 2) {
            root.app-toggle(root.app-index);
        } else if (root.on-add) {
            root.add-program();
        } else {
            root.launch(root.selected);
        }
    }

    public function back() {
        if (root.input-blocked) {
            return;
        }
        if (root.dialog != 0) {
            root.dialog = 0;
        } else if (root.panel == 2) {
            root.menu-open();
            root.panel = 1;
        } else if (root.panel == 1) {
            root.panel = 0;
        } else {
            root.dialog = 1;
        }
    }

    public function secondary() {
        if (root.idle && !root.on-add) {
            root.dialog = 2;
        }
    }

    public function add() {
        if (root.idle) {
            root.add-program();
        }
    }

    public function refresh() {
        if (root.idle) {
            root.rescan();
        }
    }

    // Menu button / F2: opens the menu, or closes it again.
    public function menu() {
        if (root.dialog != 0 || root.input-blocked) {
            return;
        }
        if (root.panel != 0) {
            root.panel = 0;
        } else {
            root.menu-open();
            root.menu-index = 0;
            root.panel = 1;
        }
    }

    public function open-apps() {
        root.apps-open();
        root.app-index = 0;
        root.panel = 2;
    }

    keys := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                root.nav-vertical(-1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.nav-vertical(1);
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.nav(-1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.nav(1);
                return accept;
            }
            if (event.text == Key.PageUp || event.text == Key.Home) {
                root.nav(event.text == Key.Home ? -10000 : -root.rows-fit);
                return accept;
            }
            if (event.text == Key.PageDown || event.text == Key.End) {
                root.nav(event.text == Key.End ? 10000 : root.rows-fit);
                return accept;
            }
            if (event.text == Key.Return || event.text == " ") {
                root.activate();
                return accept;
            }
            if (event.text == Key.Escape || event.text == Key.Backspace) {
                root.back();
                return accept;
            }
            if (event.text == Key.Delete) {
                root.secondary();
                return accept;
            }
            if (event.text == Key.Insert) {
                root.add();
                return accept;
            }
            if (event.text == Key.F5) {
                root.refresh();
                return accept;
            }
            // F2 works with every keyboard layout; "u" is a convenience.
            if (event.text == Key.F2 || event.text == "u" || event.text == "U") {
                root.menu();
                return accept;
            }
            reject
        }
    }

    // --------------------------------------------------------------- top bar

    HorizontalLayout {
        x: root.pad;
        y: root.pad * 0.6;
        width: root.width - 2 * root.pad;
        height: root.top-h;
        spacing: T.ch * 2;
        Text {
            text: "xbgg";
            color: T.accent;
            font-size: T.fs * 1.15;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            text: root.version;
            color: T.dim;
            font-size: T.fs;
            vertical-alignment: center;
        }
        Text {
            text: "│  " + root.scanned-count + " games";
            color: T.dim;
            font-size: T.fs;
            vertical-alignment: center;
        }
        Text {
            text: "│  boost " + (root.boost-chip != "" ? root.boost-chip : (root.boost-enabled ? "armed" : "off"));
            color: root.boost-chip != "" ? T.amber : T.dim;
            font-size: T.fs;
            font-weight: root.boost-chip != "" ? 700 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { }
        if root.update-version != "": Text {
            text: "update " + root.update-version + " available [≡]";
            color: T.accent;
            font-size: T.fs;
            vertical-alignment: center;
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.menu();
                }
            }
        }
        Text {
            text: root.clock;
            color: T.bright;
            font-size: T.fs;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: root.pad;
        y: root.pad * 0.6 + root.top-h;
        width: root.width - 2 * root.pad;
        height: 1px;
        background: T.line;
    }

    // --------------------------------------------------------------- library

    lib := Frame {
        x: root.pad;
        y: root.body-y;
        width: root.list-w;
        height: root.body-h;
        title: "library";

        // column headers
        property <length> col-src: self.width - T.ch * 22;
        property <length> col-played: self.width - T.ch * 11;
        Text {
            x: T.ch * 2;
            y: T.fs * 0.9;
            text: "  title";
            color: T.dim;
            font-size: T.fs * 0.85;
        }
        Text {
            x: lib.col-src;
            y: T.fs * 0.9;
            text: "source";
            color: T.dim;
            font-size: T.fs * 0.85;
        }
        Text {
            x: lib.col-played;
            y: T.fs * 0.9;
            width: T.ch * 9;
            text: "played";
            color: T.dim;
            font-size: T.fs * 0.85;
            horizontal-alignment: right;
        }

        rows := Rectangle {
            x: 1px;
            y: T.fs * 2.4;
            width: parent.width - 2px;
            height: root.rows-fit * T.row-h;
            clip: true;

            for g[i] in root.games: game-row := Rectangle {
                y: (i - root.scroll) * T.row-h;
                height: T.row-h;
                visible: i >= root.scroll && i < root.scroll + root.rows-fit;
                property <bool> sel: i == root.selected;
                background: self.sel ? T.accent : transparent;
                Text {
                    x: T.ch * 2;
                    width: lib.col-src - T.ch * 3;
                    height: 100%;
                    text: (game-row.sel ? "› " : "  ") + g.title;
                    color: game-row.sel ? T.bg : T.fg;
                    font-size: T.fs;
                    font-weight: game-row.sel ? 700 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    x: lib.col-src;
                    width: T.ch * 9;
                    height: 100%;
                    text: g.source;
                    color: game-row.sel ? T.bg : T.dim;
                    font-size: T.fs;
                    vertical-alignment: center;
                }
                Text {
                    x: lib.col-played;
                    width: T.ch * 9;
                    height: 100%;
                    text: g.played;
                    color: game-row.sel ? T.bg : T.dim;
                    font-size: T.fs;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (root.selected == i) {
                            root.activate();
                        } else {
                            root.selected = i;
                        }
                    }
                }
            }

            // "+ add game or app" — always the last row.
            add-row := Rectangle {
                property <int> i: root.games.length;
                property <bool> sel: root.on-add;
                y: (self.i - root.scroll) * T.row-h;
                height: T.row-h;
                visible: self.i >= root.scroll && self.i < root.scroll + root.rows-fit;
                background: self.sel ? T.accent : transparent;
                Text {
                    x: T.ch * 2;
                    height: 100%;
                    text: (add-row.sel ? "› " : "  ") + "+ add game or app";
                    color: add-row.sel ? T.bg : T.dim;
                    font-size: T.fs;
                    font-weight: add-row.sel ? 700 : 400;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (root.on-add) {
                            root.activate();
                        } else {
                            root.selected = root.games.length;
                        }
                    }
                }
            }
        }

        // scroll position, bottom right of the frame
        Text {
            x: parent.width - self.preferred-width - T.ch * 2;
            y: parent.height - T.fs * 1.5;
            text: (root.selected + 1) + "/" + root.count;
            color: T.dim;
            font-size: T.fs * 0.85;
        }
    }

    // ----------------------------------------------------------------- info

    info := Frame {
        x: root.info-x;
        y: root.body-y;
        width: root.info-w;
        height: root.body-h;
        title: root.on-add ? "add" : "details";

        property <length> left: T.ch * 3;
        property <length> text-y: T.fs * 1.6 + root.cover-h + T.fs * 1.4;

        // cover
        Rectangle {
            x: info.left;
            y: T.fs * 1.6;
            width: root.cover-w;
            height: root.cover-h;
            border-width: 1px;
            border-color: T.line;
            if root.has-cover && !root.on-add: Image {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                source: root.cover;
                image-fit: fill;
            }
            if !root.has-cover || root.on-add: Text {
                width: 100%;
                height: 100%;
                text: root.on-add ? "+" : "no cover";
                color: T.line;
                font-size: root.on-add ? T.fs * 4 : T.fs;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // details
        VerticalLayout {
            x: info.left;
            y: info.text-y;
            width: info.width - info.left * 2;
            spacing: T.fs * 0.35;
            alignment: start;
            Text {
                text: root.on-add ? "add a game or app" : root.current.title;
                color: T.bright;
                font-size: T.fs * 1.35;
                font-weight: 700;
                overflow: elide;
            }
            if root.on-add: Text {
                text: "pick any .exe, shortcut (.lnk .url) or script (.bat .cmd)";
                color: T.fg;
                font-size: T.fs;
                wrap: word-wrap;
            }
            if !root.on-add: Kv {
                k: "source";
                v: root.current.source + (root.current.detail != "" ? "  " + root.current.detail : "");
            }
            if !root.on-add: Kv {
                k: "played";
                v: root.current.played;
            }
            if !root.on-add: Kv {
                k: "path";
                v: root.current.path;
            }
            Rectangle {
                height: T.fs * 0.6;
            }
            HorizontalLayout {
                alignment: start;
                Key {
                    k: "A";
                    label: root.on-add ? "browse…" : "play";
                    hot: true;
                }
            }
        }
    }

    // --------------------------------------------------------------- footer

    VerticalLayout {
        x: root.pad;
        y: root.height - root.foot-h - root.pad * 0.3;
        width: root.width - 2 * root.pad;
        height: root.foot-h;
        spacing: T.fs * 0.3;
        alignment: center;
        HorizontalLayout {
            spacing: T.ch * 3;
            alignment: start;
            height: T.fs * 1.4;
            Key {
                k: "A";
                label: root.panel == 2 ? "toggle" : (root.panel == 1 ? "select" : (root.on-add ? "add" : "play"));
            }
            if root.panel == 0: Key {
                k: "X";
                label: "add";
            }
            if root.panel == 0: Key {
                k: "Y";
                label: "remove";
            }
            Key {
                k: "≡";
                label: "menu";
            }
            Key {
                k: "B";
                label: root.panel == 0 ? "exit" : "back";
            }
        }
        Text {
            text: root.status != "" ? "> " + root.status : "  ↑↓ move · enter play · ins add · del remove · f2 menu · f5 rescan · esc exit";
            color: root.status != "" ? T.fg : T.dim;
            font-size: T.fs * 0.85;
            overflow: elide;
        }
    }

    // ----------------------------------------------------------------- menu

    if root.panel == 1: menu-box := Modal {
        width: 100%;
        height: 100%;
        title: "menu";
        box-width: min(root.width - 4 * root.pad, T.ch * 64);
        box-height: T.fs * 4 + root.menu-rows.length * T.row-h;
        dismissed => {
            root.panel = 0;
        }

        for row[i] in root.menu-rows: menu-row := Rectangle {
            x: 1px;
            y: T.fs * 1.6 + i * T.row-h;
            width: menu-box.box-width - 2px;
            height: T.row-h;
            property <bool> sel: i == root.menu-index;
            property <bool> toggle: row.value == "On" || row.value == "Off";
            background: self.sel ? T.accent : transparent;
            Text {
                x: T.ch * 2;
                height: 100%;
                text: (menu-row.toggle ? (row.on ? "[x] " : "[ ] ") : "    ") + row.label;
                color: menu-row.sel ? T.bg : (row.dim ? T.dim : T.fg);
                font-size: T.fs;
                font-weight: menu-row.sel ? 700 : 400;
                vertical-alignment: center;
            }
            if !menu-row.toggle && row.value != "": Text {
                x: menu-row.width - self.preferred-width - T.ch * 2;
                height: 100%;
                text: row.value;
                color: menu-row.sel ? T.bg : (row.on ? T.amber : T.dim);
                font-size: T.fs;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.menu-index = i;
                    root.activate();
                }
            }
        }
    }

    // -------------------------------------------------------- apps to freeze

    if root.panel == 2: apps := Modal {
        width: 100%;
        height: 100%;
        title: "apps to freeze";
        box-width: min(root.width - 4 * root.pad, T.ch * 76);
        box-height: root.body-h;
        dismissed => {
            root.panel = 0;
        }

        property <length> head: T.fs * 4.2;
        property <int> fit: max(1, floor((self.box-height - self.head - T.fs * 2) / T.row-h));
        property <int> top: max(0, min(root.app-index - floor(self.fit / 2), root.app-rows.length - self.fit));

        Text {
            x: T.ch * 2;
            y: T.fs * 1.4;
            width: apps.box-width - T.ch * 4;
            text: "frozen while a game runs, resumed when it closes. nothing is closed, no work is lost.";
            color: T.dim;
            font-size: T.fs * 0.85;
            wrap: word-wrap;
        }

        Rectangle {
            x: 1px;
            y: apps.head;
            width: apps.box-width - 2px;
            height: apps.fit * T.row-h;
            clip: true;
            for row[i] in root.app-rows: app-row := Rectangle {
                y: (i - apps.top) * T.row-h;
                height: T.row-h;
                visible: i >= apps.top && i < apps.top + apps.fit;
                property <bool> sel: i == root.app-index;
                background: self.sel ? T.accent : transparent;
                Text {
                    x: T.ch * 2;
                    width: T.ch * 40;
                    height: 100%;
                    text: (row.on ? "[x] " : "[ ] ") + row.name;
                    color: app-row.sel ? T.bg : T.fg;
                    font-size: T.fs;
                    font-weight: app-row.sel ? 700 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    x: app-row.width - self.width - T.ch * 2;
                    width: T.ch * 30;
                    height: 100%;
                    text: row.detail;
                    color: app-row.sel ? T.bg : T.dim;
                    font-size: T.fs;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.app-index = i;
                        root.activate();
                    }
                }
            }
        }

        Text {
            x: apps.box-width - self.preferred-width - T.ch * 2;
            y: apps.box-height - T.fs * 1.6;
            text: (root.app-index + 1) + "/" + root.app-rows.length;
            color: T.dim;
            font-size: T.fs * 0.85;
        }
    }

    // ---------------------------------------------------------- confirmation

    if root.dialog != 0: dialog-box := Modal {
        width: 100%;
        height: 100%;
        title: root.dialog == 1 ? "exit" : (root.dialog == 3 ? "update" : "remove");
        box-width: min(root.width - 4 * root.pad, T.ch * 62);
        box-height: T.fs * 8.4;
        dismissed => {
            root.dialog = 0;
        }

        VerticalLayout {
            x: T.ch * 3;
            y: T.fs * 1.6;
            width: dialog-box.box-width - T.ch * 6;
            spacing: T.fs * 0.6;
            alignment: start;
            Text {
                text: root.dialog == 1 ? "exit xbgg?"
                    : root.dialog == 3 ? "update to " + root.update-version + "?"
                    : "remove \"" + root.current.title + "\"?";
                color: T.bright;
                font-size: T.fs * 1.15;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: root.dialog == 1
                    ? "back to the windows desktop."
                    : root.dialog == 3
                    ? "downloads the release from github, verifies its sha-256 and restarts."
                    : (root.current.source == "custom"
                        ? "removed from xbgg only. no files are deleted."
                        : "hidden from xbgg only. the game stays installed.");
                color: T.dim;
                font-size: T.fs;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: T.ch * 3;
                alignment: start;
                Key {
                    k: "A";
                    label: "confirm (enter)";
                    hot: true;
                }
                Key {
                    k: "B";
                    label: "cancel (esc)";
                }
            }
        }
    }
}
